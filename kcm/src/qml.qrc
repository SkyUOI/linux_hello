<RCC>
    <qresource prefix="/kcm/kcm_linuxhello">
        <file alias="main.qml">ui/main.qml</file>
    </qresource>
    <qresource prefix="/qt/qml/org/kde/linuxhello/listDialog">
        <file alias="qmldir">ui/listDialog/qmldir</file>
        <file alias="DeleteDialog.qml">ui/listDialog/DeleteDialog.qml</file>
        <file alias="ListDialog.qml">ui/listDialog/ListDialog.qml</file>
        <file alias="ListContent.qml">ui/listDialog/ListContent.qml</file>
        <file alias="ListHead.qml">ui/listDialog/ListHead.qml</file>
        <file alias="NoFaceMessage.qml">ui/listDialog/NoFaceMessage.qml</file>
    </qresource>
    <qresource prefix="/qt/qml/org/kde/linuxhello/camera">
        <file alias="qmldir">ui/camera/qmldir</file>
        <file alias="Preview.qml">ui/camera/Preview.qml</file>
        <file alias="Capture.qml">ui/camera/Capture.qml</file>
        <file alias="Controls.qml">ui/camera/Controls.qml</file>
        <file alias="Camera.qml">ui/camera/Camera.qml</file>
    </qresource>
    <qresource prefix="/qt/qml/org/kde/linuxhello/buttons">
        <file alias="qmldir">ui/buttons/qmldir</file>
        <file alias="Buttons.qml">ui/buttons/Buttons.qml</file>
        <file alias="LoadDialog.qml">ui/buttons/LoadDialog.qml</file>
    </qresource>
    <qresource prefix="/qt/qml/org/kde/linuxhello/signalConnections">
        <file alias="qmldir">ui/signalConnections/qmldir</file>
        <file alias="KcmConnections.qml">ui/signalConnections/KcmConnections.qml</file>
        <file alias="KernelConnections.qml">ui/signalConnections/KernelConnections.qml</file>
        <file alias="MessageConnections.qml">ui/signalConnections/MessageConnections.qml</file>
        <file alias="SignalConnections.qml">ui/signalConnections/SignalConnections.qml</file>
    </qresource>
</RCC>
